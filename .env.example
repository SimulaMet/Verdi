# Verdi model endpoint (Qwen on OpenAI-compatible vLLM). Never commit real values.
# Use the /openai path for direct vLLM access (faster, lower latency than /api/v1 proxy).
VERDI_VLLM_BASE_URL=http://localhost:8000/v1
VERDI_VLLM_MODEL=qwen2.5-7b-instruct
VERDI_VLLM_API_KEY=
VERDI_MAX_CONCURRENCY=8
VERDI_REQUEST_TIMEOUT=120
VERDI_MAX_RETRIES=5
